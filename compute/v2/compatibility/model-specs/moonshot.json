        "patterns": [
          "kimi-k2.7-code*"
        ]
      },
      "id": "kimi-k2.7-code",
      "spec": {
        "contextWindow": 262144,
        "maxOutputTokens": 16384,
        "capabilities": [
          "chat",
          "code",
          "vision",
          "tool_use"
        ],
        "serviceType": [
          "chat"
        ],
        "defaultTemperature": 1,
