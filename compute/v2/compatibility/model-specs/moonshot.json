{
  "description": "Moonshot Kimi 系列模型规格。参数来源：config-center compute/providers/moonshot.json。注意 kimi-k2 存在多个子版本（k2.5/k2.6/k2-thinking），故 kimi-k2 仅用 exact 主键匹配，不用宽 pattern。",
  "specs": [
    {
      "displayName": "Kimi K3",
      "family": "kimi-k3",
      "match": {
        "exact": [
          "kimi-k3",
          "moonshotai/kimi-k3"
        ]
      },
      "id": "kimi-k3",
      "spec": {
        "contextWindow": 1048576,
        "maxOutputTokens": 1048576,
        "capabilities": [
          "chat",
          "reasoning",
          "code",
          "tool_use",
          "agent",
          "long_context",
          "vision",
          "video_understanding"
        ],
        "serviceType": [
          "reasoning"
        ],
        "supportsReasoning": true,
        "description": "Kimi K3，1M 上下文，始终开启思考，low/high/max 三档（默认 max）；输出上限与输入共享窗口，默认 max_completion_tokens=131072",
        "extra": {
          "thinkingOnly": true,
          "samplingParametersDeprecated": true
        }
      },
      "routing": {
        "tier": "flagship",
        "routingPriority": 35,
        "eligibleForAgent": true,
        "defaultReference": false,
        "reasoning": {
          "supportedModes": [
            "auto",
            "low",
            "high",
            "max"
          ],
          "defaultMode": "max"
        }
      }
    },
    {
      "displayName": "Kimi K2.7 Code",
      "family": "kimi-k2.7",
